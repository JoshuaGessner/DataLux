# Writes a C++ source holding binary files as byte arrays:
#   cmake -DOUT=fonts.cpp -DNAMES=kA,kB -DFILES=a.ttf,b.ttf -P embed.cmake
# Run at build time, from desktop/CMakeLists.txt, for the fonts. Commas, not semicolons: a list
# does not survive the trip through a custom command's arguments.
string(REPLACE "," ";" NAMES "${NAMES}")
string(REPLACE "," ";" FILES "${FILES}")
set(body "// Generated by desktop/embed.cmake. Do not edit.\nnamespace fileflow::desktop {\n")
list(LENGTH NAMES count)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET NAMES ${i} name)
    list(GET FILES ${i} file)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "extern const unsigned char ${name}[] = {${bytes}};\n")
endforeach()
string(APPEND body "}  // namespace fileflow::desktop\n")
file(WRITE "${OUT}" "${body}")
