<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Transfers and pairing remain offline. Internet access is only for the optional account
         and Google Play purchase flow; file contents never go to the licensing service. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Every screen is portrait, by design: the sender's pattern and the receiver's framing are
         laid out for two phones held upright, face to back. Hence the lint suppression on each. -->

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <!-- Manual sensor control is what locks exposure/ISO/focus for the session. Not required:
         RISK-011 says the flag is unreliable, so the probe verifies by measurement and the app
         degrades rather than refusing to install. -->
    <uses-feature
        android:name="android.hardware.camera.capability.manual_sensor"
        android:required="false" />

    <application
        android:name=".FileFlowApp"
        android:label="DataLux"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.FileFlow">

        <!-- The front door.
             Until this existed every screen was reachable only through `adb shell am start`, and
             the launcher opened the capability probe. A person holding the phone therefore got a
             wall of diagnostics and no route to the transmitter, the receiver or the aiming help. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Pairing for encrypted mode: both phones show a QR code and read each other's with the
             front camera. Not exported: only DataLux itself starts a pairing. -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Teams for encrypted mode: one key a group shares, handed out over a pairing. -->
        <activity
            android:name=".TeamsActivity"
            android:exported="false" />
        <activity android:name=".ProActivity" android:exported="false" />
        <activity
            android:name=".TeamActivity"
            android:exported="false" />

        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- The capture run (C05 CPU path, EXP-007's verification half). Exported so a run is
             scriptable from adb with its parameters as extras: a measurement whose parameters
             live in someone's memory rather than in its report is not reproducible.
             Aims first by default; scripted runs pass `aim false`. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.FileFlow.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Live aiming guidance (UI-02), standalone. Portrait-locked because the schematic
             assumes a fixed screen orientation. -->
        <activity
            android:name=".AimActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.FileFlow.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- The transmitter (C03). Fullscreen and portrait-locked: a re-layout mid-run would
             resize the surface and change the cell pitch, which the receiver would see as the
             geometry moving under it.
             `configChanges` deliberately includes `screenSize` so the activity is NOT recreated on
             a configuration change, because the surface must stay put for the whole session. -->
        <activity
            android:name=".TransmitActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.FileFlow.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <!-- "Share → DataLux" from any app sends what was shared, the same as picking it with
                 "Choose files": one file, or several as one batch. -->
            <intent-filter android:label="Send with DataLux">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="Send with DataLux">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
