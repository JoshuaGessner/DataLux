<?xml version="1.0" encoding="utf-8"?>
<!-- A received file: the ring draws itself round, then the tick. Tinted by its ImageView. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="96dp" android:height="96dp"
            android:viewportWidth="48" android:viewportHeight="48">
            <path android:name="ring"
                android:pathData="M24,4 a20,20 0 1,1 0,40 a20,20 0 1,1 0,-40"
                android:strokeColor="#FFFFFFFF" android:strokeWidth="3"
                android:strokeLineCap="round" android:trimPathEnd="0" />
            <path android:name="tick"
                android:pathData="M15,24.5 L21.5,31 L33.5,18.5"
                android:strokeColor="#FFFFFFFF" android:strokeWidth="3.5"
                android:strokeLineCap="round" android:strokeLineJoin="round"
                android:trimPathEnd="0" />
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="450"
                android:valueFrom="0" android:valueTo="1" android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="tick">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:startOffset="320"
                android:duration="320" android:valueFrom="0" android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
